# Python host-language access (GraalPy).
#
# `PyForeign` wraps a Python object (module, callable, list, dict, iterator,
# primitive). All Python interop routes through this type — `perform GraalPy in
# do ...` gives `Python.import` and `Python.eval`, both yielding
# `Result PyForeign InteropError`.
#
# THIS PACKAGE WRITES NO NATIVES. Every operation delegates to the first-party
# `Polyglot` effect from `std::polyglot::core`, whose sole handler `Runtime` is
# the only thing that touches the runtime's native interop surface. Each verb
# buries its own `perform Runtime in Polyglot.<op> …`, so a user calls
# `pf.attr{}` / `Python.import{}` with no enclosing perform and never sees a
# `Polyglot.*` op or the guest id `"python"` — that string is baked into this
# module exactly once per entry point. This is the whole point of the two-layer
# design: a third party adds a GraalVM language in pure Mezze, with no Java.
#
# The verb set is the smallest that is still COMPLETE against Python's data
# model, named the Python way: `attr`/`set_attr`/`has_attr` (getattr/setattr/
# hasattr), `item`/`set_item` (obj[k] — one subscript for list AND dict, via
# `__getitem__`/`__setitem__`), `items` (dict.items), `len`, `to_seq` (list(obj)
# — drains any iterable), `call`/`method`/`new`, and `int`/`float`/`str`/`bool`/
# `is_none`/`type_name`. Mirrors std::polyglot::jvm's shape with Python vocabulary.
use std::polyglot::core::{ InteropError, Polyglot, Runtime, Foreign }

## Opaque handle to a Python object. Wraps the public `Foreign` handle (never the
## internal native primitive); the newtype gives Mezze-level type safety against
## mixing Python and non-Python Foreigns.
pub newtype PyForeign = Foreign

## Python host effect — the typed entry point. `import` resolves and returns a
## (possibly nested) module; `eval` evaluates a Python expression. The user
## performs only `GraalPy`; its handler buries `perform Runtime` internally.
effect Python where {
  import: { module: Str } -> Result PyForeign InteropError <Python>,
  eval:   { source: Str } -> Result PyForeign InteropError <Python>
}

## Default Python host — routes through the ambient Truffle Env's GraalPy
## interpreter. Zero-field: the polyglot Context is managed by the runtime from
## `Mezze.toml [polyglot.python]`; the handler carries no user configuration.
pub type GraalPy = {}

impl Python for GraalPy where {
  ## Evaluate a Python expression. `"python"` is baked here (one of two places).
  eval = { source } ->
    perform Runtime in Polyglot.eval_raw { lang = "python", source = source },
  ## Import a module WITHOUT string interpolation: eval the constant
  ## `importlib.import_module` reference to get the importer callable, then
  ## `execute` it with the module name as a BOXED argument. The module name never
  ## enters a code string, so there is no quote-breakout / injection surface.
  import = { module } -> perform Runtime in do
    match Polyglot.eval_raw { lang = "python", source = "__import__('importlib').import_module" } is
      Ok  { val = importer } ->
        Polyglot.execute { on = importer, args = [Polyglot.box_str { val = module, lang = "python" }] }
      Err { error } -> Err { error = error },
}

## The complete Python verb set on a PyForeign. Every verb buries its own
## `perform Runtime`, so chains run with no enclosing perform. Fallible verbs
## return `Result PyForeign InteropError` (or a coerced scalar) — chain them
## directly on the Result via the mirror impl below, no `match` between steps.
impl PyForeign where {
  ## ---- attributes: getattr / setattr / hasattr ----

  ## Read an attribute — Python `obj.name`.
  attr     = { it, name } ->
    perform Runtime in Polyglot.read_member { on = it, name = name },
  ## Set an attribute — Python `obj.name = val`.
  set_attr = { it, name, val } ->
    perform Runtime in Polyglot.write_member { on = it, name = name, val = val },
  ## True iff the attribute is readable — Python `hasattr(obj, name)`.
  has_attr = { it, name } ->
    perform Runtime in Polyglot.has_member { on = it, name = name },

  ## ---- call / method / construct ----

  ## Call a callable — Python `f(*args)`.
  call   = { it, args } ->
    perform Runtime in Polyglot.execute { on = it, args = args },
  ## Call a method by name — Python `obj.name(*args)`.
  method = { it, name, args } ->
    perform Runtime in Polyglot.invoke_member { on = it, name = name, args = args },
  ## Instantiate a class — Python `Cls(*args)`.
  new    = { it, args } ->
    perform Runtime in Polyglot.instantiate { on = it, args = args },

  ## ---- subscript: obj[key] for list AND dict, via the data model ----

  ## Read a subscript — Python `obj[key]` (`__getitem__`); works for lists, dicts,
  ## numpy arrays, and anything with `__getitem__`. `key` is a PyForeign.
  item     = { it, key } ->
    perform Runtime in Polyglot.invoke_member { on = it, name = "__getitem__", args = [key] },
  ## Set a subscript — Python `obj[key] = val` (`__setitem__`).
  set_item = { it, key, val } ->
    perform Runtime in Polyglot.invoke_member { on = it, name = "__setitem__", args = [key, val] },
  ## Every entry of a mapping as a seq of two-element `[key, value]` Foreigns — the
  ## shape a codec's `decode_map` walks (Python `dict.items()`).
  items    = { it } ->
    perform Runtime in Polyglot.hash_entries { on = it },

  ## ---- length / iteration ----

  ## Python `len(obj)`, coerced to Mezze Int — via `__len__`, so it is defined
  ## wherever Python's `len` is (list, dict, str, numpy, custom `__len__`).
  len    = { it } -> perform Runtime in do
    match Polyglot.invoke_member { on = it, name = "__len__", args = [] } is
      Ok  { val = f } -> Polyglot.as_int { on = f }
      Err { error } -> Err { error = error },
  ## Drain any iterable — a list, generator, range, or `__iter__`-bearing object —
  ## into a Mezze seq of Foreigns in ONE crossing (Python `list(obj)`). The cursor
  ## stays inside the runtime, so no mutable iterator reaches pure code.
  to_seq = { it } ->
    perform Runtime in Polyglot.to_seq { on = it },

  ## ---- value coercions (out) ----

  ## Python `int(x)`.
  int       = { it } -> perform Runtime in Polyglot.as_int    { on = it },
  ## Python `float(x)`.
  float     = { it } -> perform Runtime in Polyglot.as_float  { on = it },
  ## Python `str(x)` (of an already-stringy Foreign).
  str       = { it } -> perform Runtime in Polyglot.as_str    { on = it },
  ## Python `bool(x)` (of an already-boolean Foreign).
  bool      = { it } -> perform Runtime in Polyglot.as_bool   { on = it },
  ## Python `x is None`.
  is_none   = { it } -> perform Runtime in Polyglot.is_null   { on = it },
  ## `type(x).__name__`.
  type_name = { it } -> perform Runtime in Polyglot.type_name { on = it },
}

## The SAME verbs on `Result PyForeign InteropError` — the return type of every
## fallible op above — so a pipeline reads as a flat chain
##
##     np.attr { name = "mean" }
##       .call { args = [arr] }
##       .item { key = from_int { val = 0 } }
##       .float {}
##
## with no `match` between steps. On `Ok` it delegates to the underlying
## `PyForeign`; on `Err` it propagates the error. The generic `impl Result 'a 'e`
## (map / get_or / flat_map / …) still applies on top.
impl Result PyForeign InteropError where {
  attr = { it, name } -> match it is
    Ok  { val = f } -> f.attr { name = name }
    Err { error }   -> Err { error = error },
  set_attr = { it, name, val } -> match it is
    Ok  { val = f } -> f.set_attr { name = name, val = val }
    Err { error }   -> Err { error = error },
  has_attr = { it, name } -> match it is
    Ok  { val = f } -> Ok { val = f.has_attr { name = name } }
    Err { error }   -> Err { error = error },
  call = { it, args } -> match it is
    Ok  { val = f } -> f.call { args = args }
    Err { error }   -> Err { error = error },
  method = { it, name, args } -> match it is
    Ok  { val = f } -> f.method { name = name, args = args }
    Err { error }   -> Err { error = error },
  new = { it, args } -> match it is
    Ok  { val = f } -> f.new { args = args }
    Err { error }   -> Err { error = error },
  item = { it, key } -> match it is
    Ok  { val = f } -> f.item { key = key }
    Err { error }   -> Err { error = error },
  set_item = { it, key, val } -> match it is
    Ok  { val = f } -> f.set_item { key = key, val = val }
    Err { error }   -> Err { error = error },
  items = { it } -> match it is
    Ok  { val = f } -> f.items {}
    Err { error }  -> Err { error = error },
  len = { it } -> match it is
    Ok  { val = f } -> f.len {}
    Err { error }  -> Err { error = error },
  to_seq = { it } -> match it is
    Ok  { val = f } -> f.to_seq {}
    Err { error }  -> Err { error = error },
  int = { it } -> match it is
    Ok  { val = f } -> f.int {}
    Err { error }  -> Err { error = error },
  float = { it } -> match it is
    Ok  { val = f } -> f.float {}
    Err { error }  -> Err { error = error },
  str = { it } -> match it is
    Ok  { val = f } -> f.str {}
    Err { error }  -> Err { error = error },
  bool = { it } -> match it is
    Ok  { val = f } -> f.bool {}
    Err { error }  -> Err { error = error },
  is_none = { it } -> match it is
    Ok  { val = f } -> Ok { val = f.is_none {} }
    Err { error }  -> Err { error = error },
  type_name = { it } -> match it is
    Ok  { val = f } -> Ok { val = f.type_name {} }
    Err { error }  -> Err { error = error },
}

## Constructors — lift a Mezze primitive into a PyForeign so it can be passed as
## an argument to `.method{}` / `.call{}` / `.item{}`. Each mints a foreign through
## the `Polyglot` effect with the guest id `"python"` baked in here — a caller
## writes `from_int { val = 5 }`, never a `lang` string. For containers and
## records, prefer the codec (`x.to_py {}`).
pub let from_int:   { val: Int   } -> PyForeign = { val } ->
  perform Runtime in Polyglot.box_int   { val = val, lang = "python" }
pub let from_float: { val: Float } -> PyForeign = { val } ->
  perform Runtime in Polyglot.box_float { val = val, lang = "python" }
pub let from_str:   { val: Str   } -> PyForeign = { val } ->
  perform Runtime in Polyglot.box_str   { val = val, lang = "python" }
pub let from_bool:  { val: Bool  } -> PyForeign = { val } ->
  perform Runtime in Polyglot.box_bool  { val = val, lang = "python" }
pub let null_val:   {}            -> PyForeign = {} ->
  perform Runtime in Polyglot.box_null  { lang = "python" }

## Build a Python-visible list from already-wrapped Foreign elements — an interop
## VIEW over the elements, not a copy. Backs a codec's `encode_list`.
pub let py_list: { elems: [PyForeign] } -> PyForeign = { elems } ->
  perform Runtime in Polyglot.box_list { elems = elems, lang = "python" }

## Build a Python-visible dict from parallel key and value sequences. Companion to
## `py_list`, backing a codec's `encode_map` / `encode_record`. Keys keep order.
pub let py_dict: { keys: [PyForeign], vals: [PyForeign] } -> PyForeign = { keys, vals } ->
  perform Runtime in Polyglot.box_dict { keys = keys, vals = vals, lang = "python" }
