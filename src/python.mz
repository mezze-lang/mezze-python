# Python host-language access (GraalPy).
#
# `PyForeign` wraps a Python object (module, callable, list, dict,
# iterator, primitive). All Python interop routes through this type
# — `perform GraalPy in do ...` gives access to `Python.import` and
# `Python.eval`, both yielding `Result PyForeign InteropError`.
#
# The `impl PyForeign` block below exposes BOTH Python-idiomatic
# vocabulary (`.attr{}` / `.item{}` / `.set_item{}` / `.iter{}` /
# `.next{}` / `.len{}` / `.method{}` / `.new{}` / `.call{}`) AND the
# universal InteropLibrary primitives (`.invoke_member{}`,
# `.get_member{}`, `.as_int{}`, `.array_size{}`, `.array_at{}`, …).
# Every op routes through the same `__native_polyglot_*` natives.
use std::polyglot::core::{ InteropError }

## Opaque handle to a Python object. Runtime: same `MezzeForeign`
## Java class every language uses; the newtype gives Mezze-level
## type safety against mixing Python and non-Python Foreigns.
pub newtype PyForeign = __NativeForeign

## Python host effect. `import` performs `importlib.import_module`
## and returns the requested (possibly nested) module. `eval` parses
## and evaluates a Python expression in the ambient Truffle Env.
effect Python where {
  import: { module: Str } -> Result PyForeign InteropError <Python>,
  eval:   { source: Str } -> Result PyForeign InteropError <Python>
}

## Default Python host — routes all ops through the ambient Truffle
## Env's GraalPy interpreter. Zero-field: the polyglot Context is
## managed by the runtime from `Mezze.toml [polyglot.python]`; the
## handler carries no user-visible configuration.
pub type GraalPy = {}

impl Python for GraalPy where {
  import = { module } -> __native_python_import_module { name = module },
  eval   = { source } -> __native_python_eval          { source = source },
}

## Inherent methods on PyForeign — Python-idiomatic vocabulary AND
## the universal InteropLibrary primitives. Every op routes through
## the same `__native_polyglot_*` natives.
impl PyForeign where {
  ## ---- Python-idiomatic vocabulary ----

  ## Invoke a method by name.
  method = { it, name, args } ->
    __native_polyglot_invoke_member { val = it, name = name, args = args },
  ## Instantiate a Python type (calling a class object).
  new    = { it, args } ->
    __native_polyglot_instantiate { val = it, args = args },
  ## Call a callable (function, lambda, bound method).
  call   = { it, args } ->
    __native_polyglot_execute { val = it, args = args },
  ## Read an attribute by name (Python `obj.name`).
  attr   = { it, name } ->
    __native_polyglot_read_member { val = it, name = name },
  ## Subscript access — Python `obj[key]`.
  item   = { it, key } ->
    __native_polyglot_invoke_member { val = it, name = "__getitem__", args = [key] },
  ## Indexed assignment for sequence-shaped Foreigns — Python
  ## `lst[i] = val`. Backed by InteropLibrary's `writeArrayElement`
  ## message; only meaningful for objects that expose array-element
  ## semantics (lists, bytearrays, numpy arrays). For dict-style
  ## assignment (`d[k] = v`) use `.method { name = "__setitem__", … }`.
  set_item = { it, i, val } ->
    __native_polyglot_write_array   { val = it, index = i, new_val = val },
  ## Python `iter(obj)` — return the iterator-protocol Foreign.
  iter   = { it } ->
    __native_polyglot_invoke_member { val = it, name = "__iter__", args = [] },
  ## Python `next(obj)` — advance an iterator.
  next   = { it } ->
    __native_polyglot_invoke_member { val = it, name = "__next__", args = [] },
  ## Python `len(obj)` — coerced to Mezze Int.
  len    = { it } ->
    match __native_polyglot_invoke_member { val = it, name = "__len__", args = [] } is
      Ok { val = f } -> __native_polyglot_as_long { val = f }
      Err { error } -> Err { error = error },

  ## ---- Universal InteropLibrary vocabulary ----

  ## Invoke a message-named member with args.
  invoke_member = { it, method, args } ->
    __native_polyglot_invoke_member { val = it, name = method, args = args },
  ## Read a named member.
  get_member    = { it, name } ->
    __native_polyglot_read_member    { val = it, name = name },
  ## Membership predicate.
  has_member    = { it, name } ->
    __native_polyglot_has_member     { val = it, name = name },
  ## Execute a callable Foreign.
  execute       = { it, args } ->
    __native_polyglot_execute        { val = it, args = args },
  ## Instantiate a constructable Foreign.
  instantiate   = { it, args } ->
    __native_polyglot_instantiate    { val = it, args = args },
  ## Read an array element by index.
  array_at      = { it, index } ->
    __native_polyglot_read_array     { val = it, index = index },
  ## Number of elements in an array-shaped Foreign.
  array_size    = { it } ->
    __native_polyglot_array_size     { val = it },
  ## Every element of an array-shaped Foreign, as a Mezze seq of Foreigns, in
  ## ONE crossing. `array_at` in a loop costs one native call and one Result per
  ## element; this costs one of each for the whole array, and handing a seq the
  ## other way is already O(1) through `py_list`.
  array_to_seq  = { it } ->
    __native_polyglot_array_to_seq   { val = it },
  ## True iff this Foreign is hash-shaped (a dict / mapping). Interop models
  ## hashes and members separately, so a mapping is NOT readable through
  ## `get_member` — it is reached through the three methods below.
  has_hash      = { it } ->
    __native_polyglot_has_hash_entries { val = it },
  ## Number of entries in a hash-shaped Foreign.
  hash_size     = { it } ->
    __native_polyglot_hash_size      { val = it },
  ## Read one entry by key. The key may be a Foreign or a bare Mezze value.
  hash_at       = { it, key } ->
    __native_polyglot_read_hash      { val = it, key = key },
  ## Every entry, as an array-shaped Foreign whose elements are two-element
  ## `[key, value]` Foreigns — the shape a codec's `decode_map` walks.
  hash_entries  = { it } ->
    __native_polyglot_hash_entries   { val = it },
  ## Coerce a numeric Foreign to Int.
  as_int        = { it } -> __native_polyglot_as_long    { val = it },
  ## Coerce a string Foreign to Str.
  as_str        = { it } -> __native_polyglot_as_string  { val = it },
  ## Coerce a numeric Foreign to Float.
  as_float      = { it } -> __native_polyglot_as_double  { val = it },
  ## Coerce a boolean Foreign to Bool.
  as_bool       = { it } -> __native_polyglot_as_boolean { val = it },
  ## True iff this Foreign is the guest-language null.
  is_null       = { it } -> __native_polyglot_is_null    { val = it },
  ## Debug name of the underlying guest-language type.
  type_name     = { it } -> __native_polyglot_type_name  { val = it },
}

## Chainable inherent methods on `Result PyForeign InteropError` — the
## exact return type of every fallible operation above. Mirrors every
## method on `impl PyForeign` so users can write
##
##     np.attr { name = "random" }
##       .attr { name = "default_rng" }
##       .call { args = [seed] }
##       .attr { name = "normal" }
##       .call { args = [mean, std, n] }
##       .attr { name = "mean" }
##       .call { args = [] }
##       .as_float {}
##
## without a `match` between every step. Each method threads through
## the Result: on `Ok` it delegates to the underlying `PyForeign`
## method; on `Err` it propagates unchanged.
##
## The generic `impl Result 'a 'e` (map / get_or / flat_map / …) still
## applies — this block just adds the Python-idiomatic vocabulary on
## top for the concrete `Result PyForeign InteropError` type.
impl Result PyForeign InteropError where {
  ## ---- Python-idiomatic vocabulary ----

  method = { it, name, args } -> match it is
    Ok  { val = f } -> f.method { name = name, args = args }
    Err { error }   -> Err { error = error },
  new = { it, args } -> match it is
    Ok  { val = f } -> f.new { args = args }
    Err { error }   -> Err { error = error },
  call = { it, args } -> match it is
    Ok  { val = f } -> f.call { args = args }
    Err { error }   -> Err { error = error },
  attr = { it, name } -> match it is
    Ok  { val = f } -> f.attr { name = name }
    Err { error }   -> Err { error = error },
  item = { it, key } -> match it is
    Ok  { val = f } -> f.item { key = key }
    Err { error }   -> Err { error = error },
  set_item = { it, i, val } -> match it is
    Ok  { val = f } -> f.set_item { i = i, val = val }
    Err { error }   -> Err { error = error },
  iter = { it } -> match it is
    Ok  { val = f } -> f.iter {}
    Err { error }  -> Err { error = error },
  next = { it } -> match it is
    Ok  { val = f } -> f.next {}
    Err { error }  -> Err { error = error },
  len = { it } -> match it is
    Ok  { val = f } -> f.len {}
    Err { error }  -> Err { error = error },

  ## ---- Universal InteropLibrary vocabulary ----

  invoke_member = { it, method, args } -> match it is
    Ok  { val = f } -> f.invoke_member { method = method, args = args }
    Err { error }   -> Err { error = error },
  get_member = { it, name } -> match it is
    Ok  { val = f } -> f.get_member { name = name }
    Err { error }   -> Err { error = error },
  has_member = { it, name } -> match it is
    Ok  { val = f } -> Ok { val = f.has_member { name = name } }
    Err { error }   -> Err { error = error },
  execute = { it, args } -> match it is
    Ok  { val = f } -> f.execute { args = args }
    Err { error }   -> Err { error = error },
  instantiate = { it, args } -> match it is
    Ok  { val = f } -> f.instantiate { args = args }
    Err { error }   -> Err { error = error },
  array_at = { it, index } -> match it is
    Ok  { val = f } -> f.array_at { index = index }
    Err { error }   -> Err { error = error },
  array_size = { it } -> match it is
    Ok  { val = f } -> f.array_size {}
    Err { error }  -> Err { error = error },
  as_int = { it } -> match it is
    Ok  { val = f } -> f.as_int {}
    Err { error }  -> Err { error = error },
  as_str = { it } -> match it is
    Ok  { val = f } -> f.as_str {}
    Err { error }  -> Err { error = error },
  as_float = { it } -> match it is
    Ok  { val = f } -> f.as_float {}
    Err { error }  -> Err { error = error },
  as_bool = { it } -> match it is
    Ok  { val = f } -> f.as_bool {}
    Err { error }  -> Err { error = error },
  is_null = { it } -> match it is
    Ok  { val = f } -> Ok { val = f.is_null {} }
    Err { error }  -> Err { error = error },
  type_name = { it } -> match it is
    Ok  { val = f } -> Ok { val = f.type_name {} }
    Err { error }  -> Err { error = error },
}

## Constructors — lift a Mezze primitive into a PyForeign so it can
## be passed as an argument to `.method{}` / `.call{}` etc.
pub let from_int:   { val: Int   } -> PyForeign = { val } -> __native_python_from_int   { val = val }
pub let from_float: { val: Float } -> PyForeign = { val } -> __native_python_from_float { val = val }
pub let from_str:   { val: Str   } -> PyForeign = { val } -> __native_python_from_str   { val = val }
pub let from_bool:  { val: Bool  } -> PyForeign = { val } -> __native_python_from_bool  { val = val }
pub let null_val:   {}            -> PyForeign = {}     -> __native_python_null_val    {}

## Build a Python-visible list from already-wrapped Foreign elements.
##
## The interop surface could always READ an array (`array_at`, `array_size`) but
## never build one, so there was no way to hand a guest a sequence — which is
## exactly what a codec's `encode_list` has to do. The result is an interop VIEW
## over the elements, not a copy: nothing is converted until the guest asks.
pub let py_list: { elems: [PyForeign] } -> PyForeign = { elems } ->
  __native_python_make_list { elems = elems }

## Build a Python-visible mapping from parallel key and value sequences.
## Companion to `py_list`, backing a codec's `encode_map` / `encode_record`.
## Keys keep the order they were given in.
pub let py_dict: { keys: [PyForeign], vals: [PyForeign] } -> PyForeign = { keys, vals } ->
  __native_python_make_dict { keys = keys, vals = vals }

