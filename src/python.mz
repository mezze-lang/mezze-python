# Python host-language access (GraalPy).
#
# `PyForeign` wraps a Python object (module, callable, list, dict, iterator,
# primitive). All Python interop routes through this type — `perform GraalPy in
# do ...` gives `Python.import` and `Python.eval`, both yielding
# `Result PyForeign InteropError`.
#
# THIS PACKAGE WRITES NO NATIVES. Every operation delegates to the first-party
# `Polyglot` effect from `std::polyglot::core`, whose sole handler `Runtime` is
# the only thing that touches the runtime's native interop surface. Each verb
# buries its own `perform Runtime in Polyglot.<op> …`, so a user calls
# `pf.attr{}` / `Python.import{}` with no enclosing perform and never sees a
# `Polyglot.*` op or the guest id `"python"` — that string is baked into this
# module exactly once per entry point. This is the whole point of the two-layer
# design: a third party adds a GraalVM language in pure Mezze, with no Java.
#
# The verb set is the smallest that is still COMPLETE against Python's data
# model, named the Python way: `attr`/`set_attr`/`has_attr` (getattr/setattr/
# hasattr), `item`/`set_item` (obj[k] — one subscript for list AND dict, via
# `__getitem__`/`__setitem__`), `items` (dict.items), `len`, `to_seq` (list(obj)
# — drains any iterable), `call`/`method`/`new`, and `int`/`float`/`str`/`bool`/
# `is_none`/`type_name`. Mirrors std::polyglot::jvm's shape with Python vocabulary.
use std::polyglot::core::{ InteropError, Polyglot, Runtime, Foreign }

## Opaque handle to a Python object. Wraps the public `Foreign` handle (never the
## internal native primitive); the newtype gives Mezze-level type safety against
## mixing Python and non-Python Foreigns.
pub newtype PyForeign = Foreign

## Python host effect — the typed entry point. `import` resolves and returns a
## (possibly nested) module; `eval` evaluates a Python expression. The user
## performs only `GraalPy`; its handler buries `perform Runtime` internally.
effect Python where {
  import: { module: Str } -> PyForeign <Python>,
  eval:   { source: Str } -> PyForeign <Python>
}

## Default Python host — routes through the ambient Truffle Env's GraalPy
## interpreter. Zero-field: the polyglot Context is managed by the runtime from
## `Mezze.toml [polyglot.python]`; the handler carries no user configuration. The
## handler type is introduced by the impl itself — no separate `type` is needed.
impl Python for GraalPy where {
  ## Evaluate a Python expression. `"python"` is baked here (one of two places).
  ## `eval_raw` yields a bare error-carrying foreign; `lift` turns it into the
  ## `Result` this entry point promises (the one crossing, once, at entry).
  eval = { source } -> perform Runtime in
    Polyglot.eval_raw { lang = "python", source = source },
  ## Import a module WITHOUT string interpolation: eval the constant
  ## `importlib.import_module` reference to get the importer callable, then
  ## `execute` it with the module name as a BOXED argument. The module name never
  ## enters a code string, so there is no quote-breakout / injection surface.
  ## `eval_raw` and `execute` both yield bare foreigns, so the two producer steps
  ## chain on the foreign and `lift` materializes the single `Result` at the end.
  import = { module } -> perform Runtime in
    Polyglot.execute {
        on = Polyglot.eval_raw { lang = "python", source = "__import__('importlib').import_module" },
        args = [Polyglot.box_str { val = module, lang = "python" }],
      },
}

## Sandboxed Python host — the SAME `Python` effect as `GraalPy`, but every op runs
## in an isolated INNER context with an explicit access policy. `perform GraalPyWith
## { config } in do …` IS the isolation boundary: `initialize_scope` opens the inner
## context (handle bound to `scope`), `finalize_scope` closes it. A `Python.eval`
## result is a live foreign over that context, chainable with `.int{}`/`.attr{}` until
## it closes. User code still writes only `Python.*` — `Polyglot`/`Runtime`/`"python"`
## stay buried. `config` is a structural record (not a nominal type); spread
## `py_defaults` and override only the knobs you want to deny.
impl Python for GraalPyWith { config: { allow_io: Bool, allow_native: Bool, allow_create_thread: Bool, allow_create_process: Bool, allow_host_class_loading: Bool, allow_host_lookup: Bool, allow_polyglot_access: Bool } } where {
  initialize_scope = {} -> perform Runtime in Polyglot.open_context { lang = "python", config = config },
  finalize_scope = {} -> do
    let _ = perform Runtime in Polyglot.close_context { ctx = scope }
    {},
  eval = { source } -> perform Runtime in
    Polyglot.eval_in { ctx = scope, source = source },
  import = { module } -> perform Runtime in
    Polyglot.execute {
        on = Polyglot.eval_in { ctx = scope, source = "__import__('importlib').import_module" },
        args = [Polyglot.box_str { val = module, lang = "python" }],
      },
}

## Default `Context.Builder` policy for `GraalPyWith` — PERMISSIVE (matches ambient
## `GraalPy`; `allow_native = True` so NumPy's C extensions load). Sandboxing is
## OPT-IN: spread and deny, e.g. `GraalPyWith { config = { ...py_defaults, allow_io = False } }`.
pub let py_defaults: { allow_io: Bool, allow_native: Bool, allow_create_thread: Bool, allow_create_process: Bool, allow_host_class_loading: Bool, allow_host_lookup: Bool, allow_polyglot_access: Bool } =
  { allow_io = True, allow_native = True, allow_create_thread = True, allow_create_process = True, allow_host_class_loading = True, allow_host_lookup = True, allow_polyglot_access = True }

## The complete Python verb set on a PyForeign. Every verb buries its own
## `perform Runtime`, so chains run with no enclosing perform.
##
## PRODUCER verbs yield a bare ERROR-CARRYING PyForeign, so they chain directly:
## `Python.eval { … }.attr { name = "x" }.int {}`. CROSSING verbs are where the
## error surfaces, as `Result X InteropError`. There is NO `impl Result PyForeign`
## mirror: an inherent method belongs to the module owning the receiver, and
## `Result` is owned by `std::result` (V0406).
impl PyForeign where {
  ## ---- attributes: getattr / setattr / hasattr ----

  ## Read an attribute — Python `getattr(obj, name)`. Routed through Python's
  ## attribute protocol (a cached helper lambda) rather than raw interop
  ## read_member, so it resolves on PRIMITIVES too: a Python str/int/float/bool
  ## crosses as an interop value with no members, but `getattr` still finds its
  ## methods — `Python.eval { source = "'abc'" }.attr { name = "upper" }` works.
  attr     = { it, name } ->
    perform Runtime in Polyglot.execute {
      on = Polyglot.eval_in { ctx = it, source = "lambda o, n: getattr(o, n)" },
      args = [it, Polyglot.box_str { val = name, lang = "python" }],
    },
  ## Set an attribute — Python `setattr(obj, name, val)`; yields the receiver.
  set_attr = { it, name, val } ->
    perform Runtime in Polyglot.execute {
      on = Polyglot.eval_in { ctx = it, source = "lambda o, n, v: (setattr(o, n, v), o)[1]" },
      args = [it, Polyglot.box_str { val = name, lang = "python" }, val],
    },
  ## True iff the attribute exists — Python `hasattr(obj, name)`.
  has_attr = { it, name } ->
    perform Runtime in Polyglot.as_bool {
      on = Polyglot.execute {
        on = Polyglot.eval_in { ctx = it, source = "lambda o, n: hasattr(o, n)" },
        args = [it, Polyglot.box_str { val = name, lang = "python" }],
      },
    },

  ## ---- call / method / construct ----

  ## Call a callable — Python `f(*args)`.
  call   = { it, args } ->
    perform Runtime in Polyglot.execute { on = it, args = args },
  ## Call a method by name — Python `getattr(obj, name)(*args)`. Routed through
  ## Python's attribute protocol (a cached helper lambda) rather than raw interop
  ## invoke_member, so it works on PRIMITIVES as well as objects:
  ##
  ##   Python.eval { source = "'abc'" }.method { name = "upper", args = [] }.str {}   # "ABC"
  method = { it, name, args } ->
    perform Runtime in Polyglot.execute {
      on = Polyglot.eval_in { ctx = it, source = "lambda o, n, a: getattr(o, n)(*a)" },
      args = [it, Polyglot.box_str { val = name, lang = "python" }, Polyglot.box_list { elems = args, lang = "python" }],
    },
  ## Instantiate a class — Python `Cls(*args)`.
  new    = { it, args } ->
    perform Runtime in Polyglot.instantiate { on = it, args = args },

  ## ---- subscript: obj[key] for list AND dict, via the data model ----

  ## Read a subscript — Python `obj[key]` (`__getitem__`); works for lists, dicts,
  ## numpy arrays, and anything with `__getitem__`. `key` is a PyForeign.
  item     = { it, key } ->
    perform Runtime in Polyglot.invoke_member { on = it, name = "__getitem__", args = [key] },
  ## Set a subscript — Python `obj[key] = val` (`__setitem__`).
  set_item = { it, key, val } ->
    perform Runtime in Polyglot.invoke_member { on = it, name = "__setitem__", args = [key, val] },
  ## Every entry of a mapping as a seq of two-element `[key, value]` Foreigns — the
  ## shape a codec's `decode_mapping` walks (Python `dict.items()`).
  items    = { it } ->
    perform Runtime in Polyglot.hash_entries { on = it },

  ## ---- length / iteration ----

  ## Python `len(obj)`, coerced to Mezze Int — via `__len__`, so it is defined
  ## wherever Python's `len` is (list, dict, str, numpy, custom `__len__`).
  len    = { it } -> perform Runtime in
    # `invoke_member` yields a BARE (error-carrying) foreign — NOT a Result — so
    # it must NOT be matched as Ok/Err (that crashed with "no variant tag
    # matched"). Thread it into `as_int`, the crossing that turns the foreign
    # into `Result Int InteropError`, surfacing any error `__len__` carried.
    Polyglot.as_int { on = Polyglot.invoke_member { on = it, name = "__len__", args = [] } },
  ## Drain any iterable — a list, generator, range, or `__iter__`-bearing object —
  ## into a Mezze seq of Foreigns in ONE crossing (Python `list(obj)`). The cursor
  ## stays inside the runtime, so no mutable iterator reaches pure code.
  to_seq = { it } ->
    perform Runtime in Polyglot.to_seq { on = it },
  ## Bulk-drain a NUMERIC list/array/iterable → Mezze `[Int]` / `[Float]` in ONE
  ## crossing (the element loop AND coercion stay host-side, numpy scalars unwrapped
  ## via `.item()`). THE bulk path for numeric data — prefer over a per-element
  ## `item{}` + `int{}` loop (one crossing per element).
  to_ints   = { it } -> perform Runtime in Polyglot.to_int_seq   { on = it },
  to_floats = { it } -> perform Runtime in Polyglot.to_float_seq { on = it },
  ## Bulk-drain a STRING / BOOLEAN list → Mezze `[Str]` / `[Bool]` in ONE crossing.
  to_strs   = { it } -> perform Runtime in Polyglot.to_str_seq   { on = it },
  to_bools  = { it } -> perform Runtime in Polyglot.to_bool_seq  { on = it },

  ## ---- value coercions (out) ----

  ## Python `int(x)`.
  int       = { it } -> perform Runtime in Polyglot.as_int    { on = it },
  ## Python `float(x)`.
  float     = { it } -> perform Runtime in Polyglot.as_float  { on = it },
  ## Python `str(x)` (of an already-stringy Foreign).
  str       = { it } -> perform Runtime in Polyglot.as_str    { on = it },
  ## Python `bool(x)` (of an already-boolean Foreign).
  bool      = { it } -> perform Runtime in Polyglot.as_bool   { on = it },
  ## Python `x is None`.
  is_none   = { it } -> perform Runtime in Polyglot.is_null   { on = it },
  ## `type(x).__name__`.
  type_name = { it } -> perform Runtime in Polyglot.type_name { on = it },
  ## Presence/liveness probe: `Ok {}` if the foreign is live, `Err` if it carries
  ## an error (e.g. an absent key / attribute read back as an errored foreign).
  ## Backs a codec's missing-field / absent-payload check.
  check     = { it } -> perform Runtime in Polyglot.check { on = it },
}

## Constructors — lift a Mezze primitive into a PyForeign so it can be passed as
## an argument to `.method{}` / `.call{}` / `.item{}`. Each mints a foreign through
## the `Polyglot` effect with the guest id `"python"` baked in here — a caller
## writes `from_int { val = 5 }`, never a `lang` string. For containers and
## records, prefer the codec (`x.to_py {}`).
pub let from_int:   { val: Int   } -> PyForeign <*> = { val } ->
  perform Runtime in Polyglot.box_int   { val = val, lang = "python" }
pub let from_float: { val: Float } -> PyForeign <*> = { val } ->
  perform Runtime in Polyglot.box_float { val = val, lang = "python" }
pub let from_str:   { val: Str   } -> PyForeign <*> = { val } ->
  perform Runtime in Polyglot.box_str   { val = val, lang = "python" }
pub let from_bool:  { val: Bool  } -> PyForeign <*> = { val } ->
  perform Runtime in Polyglot.box_bool  { val = val, lang = "python" }
pub let null_val:   {}            -> PyForeign <*> = {} ->
  perform Runtime in Polyglot.box_null  { lang = "python" }

## Build a Python-visible list from already-wrapped Foreign elements — an interop
## VIEW over the elements, not a copy. Backs a codec's `encode_sequence`.
pub let py_list: { elems: [PyForeign] } -> PyForeign <*> = { elems } ->
  perform Runtime in Polyglot.box_list { elems = elems, lang = "python" }

## Bulk numeric WRITE: box a whole `[Int]` / `[Float]` into a Python list in ONE
## crossing — no per-element `from_int`. Companion to `py_list` for numeric data.
pub let py_ints:   { vals: [Int] }   -> PyForeign <*> = { vals } ->
  perform Runtime in Polyglot.box_int_seq   { vals = vals, lang = "python" }
pub let py_floats: { vals: [Float] } -> PyForeign <*> = { vals } ->
  perform Runtime in Polyglot.box_float_seq { vals = vals, lang = "python" }
pub let py_strs:   { vals: [Str] }   -> PyForeign <*> = { vals } ->
  perform Runtime in Polyglot.box_str_seq   { vals = vals, lang = "python" }
pub let py_bools:  { vals: [Bool] }  -> PyForeign <*> = { vals } ->
  perform Runtime in Polyglot.box_bool_seq  { vals = vals, lang = "python" }

## Build a Python-visible dict from parallel key and value sequences. Companion to
## `py_list`, backing a codec's `encode_mapping` / `encode_record`. Keys keep order.
pub let py_dict: { keys: [PyForeign], vals: [PyForeign] } -> PyForeign <*> = { keys, vals } ->
  perform Runtime in Polyglot.box_dict { keys = keys, vals = vals, lang = "python" }

## A Mezze function as a Python callable. Python calls are POSITIONAL here — the
## interop call carries no keyword arguments — so `py_fn` receives whatever Python
## passes as one `args` list of `PyForeign` (decode with `.int{}` / `.str{}`), and
## `py_fn1` / `py_fn2` fix the arity for `map(f, xs)`, `sorted(key=f)`, `reduce(f)`;
## Python calling with the wrong count is Python's TypeError, raised to Python. The
## function's row is EMPTY on purpose: Python calls it OUTSIDE every `perform`, from
## its own thread under its interpreter lock, so it may do nothing that needs a
## handler — completing a promise is the model use.
##
## `asyncio` has no loop running unless someone runs it: a reactor built on Python's
## loop runs `loop.run_forever()` on one Mezze-side task and completes promises from
## the callbacks it schedules there.
pub let py_fn:  { f: { args: [PyForeign] } -> 'r } -> PyForeign <*> = { f } ->
  perform Runtime in Polyglot.box_fn  { f = f, lang = "python" }
pub let py_fn1: { f: { x: PyForeign } -> 'r } -> PyForeign <*> = { f } ->
  perform Runtime in Polyglot.box_fn1 { f = f, lang = "python" }
pub let py_fn2: { f: { a: PyForeign, b: PyForeign } -> 'r } -> PyForeign <*> = { f } ->
  perform Runtime in Polyglot.box_fn2 { f = f, lang = "python" }
